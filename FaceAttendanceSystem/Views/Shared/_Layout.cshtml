@using FaceAttendanceSystem.Infrastructure
@{
    var principal = User as AppPrincipal;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - FaceAttend</title>
    @Styles.Render("~/Content/css")
    @RenderSection("head", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="@Url.Action("Index", "Home")">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2" />
                    <circle cx="9" cy="10" r="1" /><circle cx="15" cy="10" r="1" />
                    <path d="M9 15c1.5 1.3 4.5 1.3 6 0" />
                </svg>
                FaceAttend
            </a>
            @if (principal != null)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole("Admin"))
                        {
                            @Html.NavLink("Dashboard", "Dashboard", "Admin")
                            @Html.NavLink("Students", "Index", "Students")
                            @Html.NavLink("Teachers", "Index", "Teachers")
                            @Html.NavLink("Subjects", "Index", "Subjects")
                            @Html.NavLink("Assignments", "Index", "Assignments")
                            @Html.NavLink("Sessions", "History", "Session")
                            @Html.NavLink("Reports", "Index", "Reports")
                            @Html.NavLink("Settings", "Settings", "Settings")
                            @Html.NavLink("Audit log", "Index", "Audit")
                        }
                        else if (User.IsInRole("Teacher"))
                        {
                            @Html.NavLink("Dashboard", "Dashboard", "Teacher")
                            @Html.NavLink("Start session", "Start", "Session", "Start", "Live")
                            @Html.NavLink("History", "History", "Session", "History", "Detail")
                            @Html.NavLink("Face enrollment", "Index", "Enrollment")
                            @Html.NavLink("Reports", "Index", "Reports")
                        }
                        else if (User.IsInRole("Student"))
                        {
                            @Html.NavLink("Dashboard", "Dashboard", "Student")
                            @Html.NavLink("Profile", "Profile", "Student")
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @principal.FullName <span class="badge rounded-pill text-bg-light ms-1">@principal.Role</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span class="dropdown-item-text small text-muted">Signed in as @principal.Username</span></li>
                                <li><a class="dropdown-item" href="@Url.Action("ChangePassword", "Account")">Change password</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item">Sign out</button>
                                    }
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </nav>

    <main class="container flex-grow-1 py-4">
        @Html.Partial("_Flash")
        @RenderBody()
    </main>

    <footer class="border-top py-3 small text-muted">
        <div class="container d-flex justify-content-between">
            <span>FaceAttend &middot; Face recognition attendance</span>
            <span>&copy; @DateTime.Now.Year</span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
