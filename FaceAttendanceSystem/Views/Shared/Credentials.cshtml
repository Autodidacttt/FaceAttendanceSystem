@model CredentialsViewModel
@{
    ViewBag.Title = "Temporary password";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h4">@(Model.IsReset ? "Password reset" : "Account created")</h1>
                <p class="mb-3">Give these sign-in details to <strong>@Model.FullName</strong>. They must choose a new password the first time they sign in.</p>
                <dl class="row mb-3">
                    <dt class="col-sm-4">Username</dt>
                    <dd class="col-sm-8"><code>@Model.Username</code></dd>
                    <dt class="col-sm-4">Temporary password</dt>
                    <dd class="col-sm-8"><span class="temp-password">@Model.TemporaryPassword</span></dd>
                </dl>
                <div class="alert alert-warning small mb-3">
                    This password is shown <strong>only once</strong> and is not stored anywhere in readable form.
                    If it is lost, reset the password again.
                </div>
                <a class="btn btn-primary" href="@Url.Action("Index", Model.BackController)">Done</a>
            </div>
        </div>
    </div>
</div>
