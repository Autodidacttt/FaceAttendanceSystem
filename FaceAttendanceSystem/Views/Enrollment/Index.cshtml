@model EnrollmentListViewModel
@{
    ViewBag.Title = "Face enrollment";
}
<h1 class="h3 mb-1">Face enrollment</h1>
<p class="text-muted small mb-3">
    Pick a student to capture their face samples.
    @if (User.IsInRole("Teacher")) { <text>You can enroll students on the rosters of your assigned subjects.</text> }
</p>

<form method="get" class="row g-2 mb-3 align-items-center" role="search">
    <div class="col-sm-6 col-md-5">
        <input type="search" name="q" value="@Model.Query" class="form-control" placeholder="Search roll no. or name" aria-label="Search students" />
    </div>
    <div class="col-auto form-check ms-2">
        <input class="form-check-input" type="checkbox" name="missing" value="true" id="onlyMissing" @(Model.OnlyMissing ? "checked" : "") />
        <label class="form-check-label" for="onlyMissing">Only students without samples</label>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Roll no.</th><th>Name</th><th>Class</th><th>Samples</th><th class="text-end"></th></tr></thead>
            <tbody>
                @if (!Model.Students.Items.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No students found.</td></tr>
                }
                @foreach (var s in Model.Students.Items)
                {
                    <tr>
                        <td class="fw-semibold">@s.RollNumber</td>
                        <td>@s.FullName @if (!s.IsActive) { <span class="badge text-bg-dark ms-1">Inactive</span> }</td>
                        <td class="small">@s.Department &middot; Sem @s.Semester</td>
                        <td>
                            @if (s.FaceSamples > 0) { <span class="badge text-bg-success">@s.FaceSamples</span> }
                            else { <span class="badge text-bg-secondary">None</span> }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-primary" href="@Url.Action("Index", new { id = s.Id })">@(s.FaceSamples > 0 ? "Manage" : "Enroll")</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        @Html.Partial("_Pager", Model.Students)
    </div>
</div>
