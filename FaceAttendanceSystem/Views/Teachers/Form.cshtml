@model TeacherFormViewModel
@{
    var isNew = Model.Id == null;
    ViewBag.Title = isNew ? "Add teacher" : "Edit teacher";
    var departments = ViewBag.Departments as string[] ?? new string[0];
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("Index")">Teachers</a></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewBag.Title</li>
    </ol>
</nav>
<h1 class="h3 mb-3">@ViewBag.Title</h1>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm(isNew ? "Create" : "Edit", "Teachers", isNew ? null : new { id = Model.Id }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="row g-3">
                <div class="col-md-6">
                    @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "off" })
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-6">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-3">
                    @Html.LabelFor(m => m.EmployeeNumber, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.EmployeeNumber, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.EmployeeNumber, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-3">
                    @Html.LabelFor(m => m.Department, new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Department, new { @class = "form-control", list = "departmentList" })
                    <datalist id="departmentList">
                        @foreach (var d in departments) { <option value="@d"></option> }
                    </datalist>
                    @Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger small" })
                </div>
                <div class="col-12">
                    <div class="form-check">
                        @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">@(isNew ? "Create teacher" : "Save changes")</button>
                <a class="btn btn-outline-secondary" href="@Url.Action("Index")">Cancel</a>
            </div>
            if (isNew)
            {
                <p class="small text-muted mt-3 mb-0">A temporary password is generated and shown once after the teacher is created. Assign subjects on the Assignments page.</p>
            }
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
