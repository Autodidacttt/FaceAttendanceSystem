@model TeacherListViewModel
@{
    ViewBag.Title = "Teachers";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Teachers</h1>
    <a class="btn btn-primary" href="@Url.Action("Create")">Add teacher</a>
</div>

<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-sm-8 col-md-6">
        <input type="search" name="q" value="@Model.Query" class="form-control" placeholder="Search name, username, employee no. or department" aria-label="Search teachers" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-secondary" type="submit">Search</button>
        @if (!string.IsNullOrEmpty(Model.Query))
        {
            <a class="btn btn-link" href="@Url.Action("Index")">Clear</a>
        }
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th>Employee no.</th><th>Name</th><th>Username</th><th>Department</th><th>Subjects</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.Teachers.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No teachers found.</td></tr>
                }
                @foreach (var t in Model.Teachers.Items)
                {
                    <tr>
                        <td class="fw-semibold">@t.EmployeeNumber</td>
                        <td>@t.FullName<div class="small text-muted">@t.Email</div></td>
                        <td><code>@t.Username</code></td>
                        <td class="small">@t.Department</td>
                        <td>
                            @foreach (var code in t.SubjectCodes)
                            {
                                <span class="badge text-bg-light border">@code</span>
                            }
                            @if (!t.SubjectCodes.Any()) { <span class="small text-muted">None</span> }
                        </td>
                        <td>
                            @if (!t.IsActive) { <span class="badge text-bg-dark">Inactive</span> }
                            else if (t.IsLockedOut) { <span class="badge text-bg-warning">Locked</span> }
                            else { <span class="badge text-bg-light">Active</span> }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Edit", new { id = t.Id })">Edit</a>
                            @using (Html.BeginForm("ResetPassword", "Teachers", new { id = t.Id }, FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Reset this teacher\\'s password? A new temporary password will be shown once.');" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning">Reset password</button>
                            }
                            <a class="btn btn-sm btn-outline-danger" href="@Url.Action("Delete", new { id = t.Id })">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        @Html.Partial("_Pager", Model.Teachers)
    </div>
</div>
