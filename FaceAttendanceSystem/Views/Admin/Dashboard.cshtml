@model AdminDashboardViewModel
@{
    ViewBag.Title = "Admin dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h1 class="h3 mb-0">Admin dashboard</h1>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Create", "Students")">Add student</a>
        <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Create", "Teachers")">Add teacher</a>
        <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Create", "Subjects")">Add subject</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-2">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Students</div>
            <div class="stat-value">@Model.StudentCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Teachers</div>
            <div class="stat-value">@Model.TeacherCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Subjects</div>
            <div class="stat-value">@Model.SubjectCount</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Sessions today</div>
            <div class="stat-value">@Model.SessionsToday</div>
            <div class="small text-muted">@Model.ActiveSessions in progress</div>
        </div></div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Today's attendance</div>
            @if (Model.TodayExpected == 0)
            {
                <div class="stat-value text-muted">&ndash;</div>
                <div class="small text-muted">No sessions held today yet.</div>
            }
            else
            {
                <div class="stat-value @HtmlExtensions.PercentClass(Model.TodayPercent)">@UiFormat.Percent(Model.TodayPercent)</div>
                <div class="progress mt-2" style="height: 6px;" role="progressbar" aria-label="Today's attendance"
                     aria-valuenow="@Model.TodayPercent" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: @Model.TodayPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                </div>
                <div class="small text-muted mt-1">@Model.TodayPresent present of @Model.TodayExpected expected</div>
            }
        </div></div>
    </div>
</div>

@if (Model.StudentsWithoutFace > 0)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <span>@Model.StudentsWithoutFace active student(s) have no face enrollment yet and cannot be recognised.</span>
        <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Index", "Enrollment")">Enroll faces</a>
    </div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 mb-3">Lowest attendance (5 students)</h2>
                @if (!Model.LowestAttendance.Any())
                {
                    <p class="text-muted mb-0">No sessions have been held yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead><tr><th>Roll no.</th><th>Name</th><th>Class</th><th class="text-end">Present</th><th class="text-end">%</th></tr></thead>
                            <tbody>
                                @foreach (var row in Model.LowestAttendance)
                                {
                                    <tr>
                                        <td>@row.RollNumber</td>
                                        <td>@row.FullName</td>
                                        <td class="small text-muted">@row.Department &middot; Sem @row.Semester</td>
                                        <td class="text-end">@row.Present / @row.SessionsHeld</td>
                                        <td class="text-end @HtmlExtensions.PercentClass(row.Percent)">@UiFormat.Percent(row.Percent)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 mb-0">Recent activity</h2>
                    <a class="small" href="@Url.Action("Index", "Audit")">Full audit log</a>
                </div>
                <ul class="list-unstyled small mb-0">
                    @foreach (var entry in Model.RecentActivity)
                    {
                        <li class="mb-2">
                            <span class="text-muted">@entry.TimestampUtc.ToLocalDisplay()</span>
                            &middot; <strong>@entry.Action</strong>
                            @if (!string.IsNullOrEmpty(entry.Username)) { <span>by @entry.Username</span> }
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
