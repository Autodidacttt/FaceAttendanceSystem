@model HistoryViewModel
@{
    ViewBag.Title = "Session history";
    var showTeacher = User.IsInRole("Admin");
    var byStudent = Model.RollStudentName != null;
}
<h1 class="h3 mb-3">Session history</h1>

<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label small" for="subjectId">Subject</label>
            @Html.DropDownList("subjectId", Model.SubjectOptions, "All subjects", new { @class = "form-select", id = "subjectId" })
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small" for="from">From</label>
            <input type="date" class="form-control" id="from" name="from" value="@(Model.From.HasValue ? Model.From.Value.ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small" for="to">To</label>
            <input type="date" class="form-control" id="to" name="to" value="@(Model.To.HasValue ? Model.To.Value.ToString("yyyy-MM-dd") : "")" />
        </div>
        <div class="col-md-2">
            <label class="form-label small" for="roll">Roll no.</label>
            <input type="text" class="form-control" id="roll" name="roll" value="@Model.Roll" placeholder="e.g. S001" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
            <a class="btn btn-outline-secondary" href="@Url.Action("History")" title="Clear filters">&times;</a>
        </div>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning">@Model.Message</div>
}
@if (byStudent)
{
    <div class="alert alert-info py-2">Showing sessions for <strong>@Model.RollStudentName (@Model.Roll)</strong> with their status in each.</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Date</th><th>Subject</th>@if (showTeacher) { <th>Teacher</th> }<th>Status</th>
                    <th class="text-end">Present</th><th class="text-end">%</th>
                    @if (byStudent) { <th>@Model.Roll</th> }
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Sessions.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No sessions match these filters.</td></tr>
                }
                @foreach (var s in Model.Sessions.Items)
                {
                    <tr>
                        <td class="text-nowrap">@s.StartedUtc.ToLocalDisplay()</td>
                        <td><span class="fw-semibold">@s.SubjectCode</span> <span class="small text-muted">@s.SubjectName</span></td>
                        @if (showTeacher) { <td class="small">@s.TeacherName</td> }
                        <td>@if (s.IsActive) { <span class="badge text-bg-success">In progress</span> } else { <span class="badge text-bg-light border">Ended</span> }</td>
                        <td class="text-end">@s.PresentCount / @s.RosterSize</td>
                        <td class="text-end @HtmlExtensions.PercentClass(s.Percent)">@UiFormat.Percent(s.Percent)</td>
                        @if (byStudent)
                        {
                            <td>@if (s.StudentStatus == "Present") { <span class="badge text-bg-success">Present</span> } else { <span class="badge text-bg-danger">Absent</span> }</td>
                        }
                        <td class="text-end"><a class="btn btn-sm btn-outline-primary" href="@Url.Action("Detail", new { id = s.Id })">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white">
        @Html.Partial("_Pager", Model.Sessions)
    </div>
</div>
