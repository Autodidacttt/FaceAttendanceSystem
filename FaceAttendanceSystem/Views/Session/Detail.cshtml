@model SessionPageViewModel
@{
    ViewBag.Title = "Session " + Model.SubjectCode;
    var onRoster = Model.Roster.Where(r => r.OnRoster).ToList();
    var presentCount = Model.Roster.Count(r => r.IsPresent);
    var absentCount = onRoster.Count(r => !r.IsPresent);
    var percent = FaceAttendanceSystem.Services.ReportService.Percent(onRoster.Count(r => r.IsPresent), onRoster.Count);
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="@Url.Action("History")">Sessions</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.SubjectCode, @Model.StartedUtc.ToLocalDisplay()</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div>
        <h1 class="h4 mb-0">@Model.SubjectCode &ndash; @Model.SubjectName</h1>
        <div class="text-muted small">
            @Model.TeacherName &middot; @Model.Department, semester @Model.Semester &middot;
            @Model.StartedUtc.ToLocalDisplay() &ndash; @(Model.IsActive ? "in progress" : Model.EndedUtc.Value.ToLocal().ToString("HH:mm"))
            @if (!string.IsNullOrEmpty(Model.Notes)) { <text>&middot; @Model.Notes</text> }
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (Model.IsActive && User.IsInRole("Teacher") && Model.CanEdit)
        {
            <a class="btn btn-success" href="@Url.Action("Live", new { id = Model.SessionId })">Back to camera</a>
        }
        <a class="btn btn-outline-secondary" href="@Url.Action("SessionCsv", "Reports", new { id = Model.SessionId })">Export CSV</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-4"><div class="card stat-card"><div class="card-body">
        <div class="stat-label">Present</div><div class="stat-value text-success">@presentCount</div>
    </div></div></div>
    <div class="col-4"><div class="card stat-card"><div class="card-body">
        <div class="stat-label">Absent</div><div class="stat-value text-danger">@absentCount</div>
    </div></div></div>
    <div class="col-4"><div class="card stat-card"><div class="card-body">
        <div class="stat-label">Attendance</div><div class="stat-value">@UiFormat.Percent(percent)</div>
    </div></div></div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Roll no.</th><th>Name</th><th>Status</th><th>How</th><th>Time</th><th class="text-end">Distance</th><th></th>@if (Model.CanEdit) { <th class="text-end">Correct</th> }</tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Roster)
                {
                    <tr>
                        <td class="fw-semibold">@r.RollNumber</td>
                        <td>@r.FullName @if (!r.OnRoster) { <span class="badge text-bg-light border ms-1" title="No longer on this subject's roster">not on roster</span> }</td>
                        <td>
                            @if (r.IsPresent) { <span class="badge text-bg-success">Present</span> }
                            else { <span class="badge text-bg-danger">Absent</span> }
                        </td>
                        <td class="small">@(r.Method == AttendanceMethod.Face ? "Face" : r.Method == AttendanceMethod.Manual ? "Manual" : "-")</td>
                        <td class="small">@(r.MarkedUtc.HasValue ? r.MarkedUtc.Value.ToLocalTimeDisplay() : "-")</td>
                        <td class="small text-end">@(r.Distance.HasValue ? r.Distance.Value.ToString("0.000") : "")</td>
                        <td>
                            @if (r.HasSnapshot && r.AttendanceId.HasValue)
                            {
                                <a href="@Url.Action("Snapshot", new { id = r.AttendanceId })" target="_blank" rel="noopener">
                                    <img src="@Url.Action("Snapshot", new { id = r.AttendanceId })" alt="Snapshot of @r.FullName" height="40" class="rounded" loading="lazy" />
                                </a>
                            }
                        </td>
                        @if (Model.CanEdit)
                        {
                            <td class="text-end">
                                @using (Html.BeginForm("Override", "Session", new { id = Model.SessionId }, FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="studentId" value="@r.StudentId" />
                                    <input type="hidden" name="present" value="@(r.IsPresent ? "false" : "true")" />
                                    <button type="submit" class="btn btn-sm @(r.IsPresent ? "btn-outline-danger" : "btn-outline-success")">
                                        Mark @(r.IsPresent ? "absent" : "present")
                                    </button>
                                }
                            </td>
                        }
                    </tr>
                }
                @if (!Model.Roster.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No students on this roster.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="small text-muted mt-2">Manual corrections are recorded in the audit log.</p>
