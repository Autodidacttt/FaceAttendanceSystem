@model StudentDashboardViewModel
@{
    ViewBag.Title = "My attendance";
}
<div class="mb-4">
    <h1 class="h3 mb-0">Hello, @Model.FullName</h1>
    <div class="text-muted small">@Model.RollNumber &middot; @Model.Department &middot; Semester @Model.Semester</div>
</div>

@if (!Model.FaceEnrolled)
{
    <div class="alert alert-warning">
        Your face is not enrolled yet, so the camera can't mark you present. Ask your teacher or the administrator to enroll you.
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Overall attendance</div>
            @if (Model.SessionsHeld == 0)
            {
                <div class="stat-value text-muted">&ndash;</div>
                <div class="small text-muted">No classes held yet.</div>
            }
            else
            {
                <div class="stat-value @HtmlExtensions.PercentClass(Model.Percent)">@UiFormat.Percent(Model.Percent)</div>
                <div class="small text-muted">@Model.Present of @Model.SessionsHeld classes attended</div>
                if (Model.Percent < 75)
                {
                    <div class="small text-danger mt-1">Below the 75% requirement.</div>
                }
            }
        </div></div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Classes attended</div>
            <div class="stat-value text-success">@Model.Present</div>
        </div></div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card stat-card h-100"><div class="card-body">
            <div class="stat-label">Classes missed</div>
            <div class="stat-value text-danger">@(Model.SessionsHeld - Model.Present)</div>
        </div></div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 mb-3">By subject</h2>
                @if (!Model.Subjects.Any())
                {
                    <p class="text-muted mb-0">No subjects for your class yet.</p>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <thead><tr><th>Subject</th><th class="text-end">Attended</th><th style="width:40%">%</th></tr></thead>
                        <tbody>
                            @foreach (var s in Model.Subjects)
                            {
                                <tr>
                                    <td><span class="fw-semibold">@s.Code</span> <span class="small text-muted d-block">@s.Name</span></td>
                                    <td class="text-end">@s.Present / @s.SessionsHeld</td>
                                    <td>
                                        @if (s.SessionsHeld == 0)
                                        {
                                            <span class="small text-muted">No classes yet</span>
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="progress flex-grow-1" style="height: 6px;" role="progressbar" aria-label="@s.Code attendance"
                                                     aria-valuenow="@s.Percent" aria-valuemin="0" aria-valuemax="100">
                                                    <div class="progress-bar @(s.Percent < 75 ? "bg-danger" : "bg-success")" style="width: @s.Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
                                                </div>
                                                <span class="small @HtmlExtensions.PercentClass(s.Percent)">@UiFormat.Percent(s.Percent)</span>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h6 mb-3">Recent classes</h2>
                @if (!Model.Recent.Any())
                {
                    <p class="text-muted mb-0">No classes held yet.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var e in Model.Recent)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-semibold">@e.SubjectCode</span> <span class="small text-muted">@e.SubjectName</span>
                                    <div class="small text-muted">@e.StartedUtc.ToLocalDisplay()</div>
                                </div>
                                @if (e.Present)
                                {
                                    <span class="badge text-bg-success">Present @(e.Method == AttendanceMethod.Manual ? "(manual)" : "")</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">Absent</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
