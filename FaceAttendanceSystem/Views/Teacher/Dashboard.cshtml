@model TeacherDashboardViewModel
@{
    ViewBag.Title = "Teacher dashboard";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h1 class="h3 mb-0">Welcome, @Model.TeacherName</h1>
        <div class="text-muted small">@DateTime.Now.ToString("dddd, d MMMM yyyy")</div>
    </div>
    <a class="btn btn-primary" href="@Url.Action("Start", "Session")">Start attendance session</a>
</div>

@if (Model.ActiveSessions.Any())
{
    <div class="alert alert-success">
        <strong>Session in progress:</strong>
        @foreach (var s in Model.ActiveSessions)
        {
            <a class="alert-link ms-2" href="@Url.Action("Live", "Session", new { id = s.Id })">@s.SubjectCode (started @s.StartedUtc.ToLocal().ToString("HH:mm")) &rarr; resume</a>
        }
    </div>
}

<h2 class="h5 mb-3">My subjects</h2>
@if (!Model.Subjects.Any())
{
    <div class="alert alert-info">No subjects are assigned to you yet. Ask an administrator to assign your subjects.</div>
}
<div class="row g-3 mb-4">
    @foreach (var s in Model.Subjects)
    {
        <div class="col-md-6 col-xl-4">
            <div class="card h-100">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between">
                        <span class="badge text-bg-light border">@s.Code</span>
                        <span class="small text-muted">@s.Department &middot; Sem @s.Semester</span>
                    </div>
                    <h3 class="h6 mt-2">@s.Name</h3>
                    <div class="small text-muted mb-3">
                        @s.RosterSize students &middot; @s.EnrolledCount with face enrolled &middot; @s.SessionsHeld sessions held
                    </div>
                    @if (s.RosterSize > s.EnrolledCount)
                    {
                        <div class="small text-warning-emphasis mb-2">@(s.RosterSize - s.EnrolledCount) student(s) not enrolled yet.
                            <a href="@Url.Action("Index", "Enrollment", new { missing = true })">Enroll</a></div>
                    }
                    <div class="mt-auto">
                        @if (s.ActiveSessionId.HasValue)
                        {
                            <a class="btn btn-success btn-sm" href="@Url.Action("Live", "Session", new { id = s.ActiveSessionId })">Resume session</a>
                        }
                        else
                        {
                            using (Html.BeginForm("Start", "Session", FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="SubjectId" value="@s.SubjectId" />
                                <button type="submit" class="btn btn-primary btn-sm">Start session</button>
                            }
                        }
                        <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("History", "Session", new { subjectId = s.SubjectId })">History</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<h2 class="h5 mb-3">Today's sessions</h2>
<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>Subject</th><th>Started</th><th>Status</th><th class="text-end">Present</th><th class="text-end"></th></tr></thead>
            <tbody>
                @if (!Model.TodaySessions.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No sessions today yet.</td></tr>
                }
                @foreach (var s in Model.TodaySessions)
                {
                    <tr>
                        <td><span class="fw-semibold">@s.SubjectCode</span> &ndash; @s.SubjectName</td>
                        <td>@s.StartedUtc.ToLocal().ToString("HH:mm")</td>
                        <td>@if (s.IsActive) { <span class="badge text-bg-success">In progress</span> } else { <span class="badge text-bg-secondary">Ended @s.EndedUtc.Value.ToLocal().ToString("HH:mm")</span> }</td>
                        <td class="text-end">@s.PresentCount / @s.RosterSize</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action(s.IsActive ? "Live" : "Detail", "Session", new { id = s.Id })">@(s.IsActive ? "Open" : "View")</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
