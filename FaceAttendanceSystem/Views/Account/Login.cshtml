@model FaceAttendanceSystem.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Sign in";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <h1 class="h4 mb-1">Sign in</h1>
                <p class="text-muted small mb-4">Admins, teachers and students all sign in here.</p>

                @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2", role = "alert" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Username, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "username", autofocus = "autofocus" })
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-4">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Sign in</button>
                }
            </div>
        </div>

        @if (HttpContext.Current.IsDebuggingEnabled)
        {
            <div class="alert alert-secondary small mt-3">
                <strong>Demo accounts</strong> (debug builds only; each must change its password on first sign-in):<br />
                <code>admin / Admin@123</code> &middot; <code>teacher1 / Teacher@123</code> &middot; <code>S001 / Student@123</code>
            </div>
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
